# hosting 平台配置（ADR-008）——wop-skills 实例
# 用法：链入口 source 本文件（.factory/fix-issue.sh 等经由 factory_lib 消费）
# 令牌不入库：YUNXIAO_ACCESS_TOKEN 在 shell profile / keychain 提供
# 状态：占位——本仓 Codeup/GitHub 仓库 ID 待平台侧建仓后回填；
# 链脚本消费时缺配置按 fail-closed 报错，不影响 guard/lint/mutations 门
export FACTORY_HOSTING=codeup
export CODEUP_ORG_ID=            # 待回填：wop-skills 建仓后的组织 ID
export CODEUP_REPO_ID=           # 待回填：仓库 ID
export CODEUP_SPACE_ID=          # 待回填：项目空间 ID
export CODEUP_WORKITEM_TYPE_ID=  # 待回填：工作项类型 ID
export CODEUP_WORKITEM_CATEGORY=Task
export CODEUP_ASSIGN_USER_ID=    # 待回填：受理人 ID
export CODEUP_ISSUE_LABELS=description
export FACTORY_BASE_BRANCH=main
