#!/usr/bin/env python3
"""wop — WOP 网关官方 CLI（skills/wop-cli 基座载体）

对齐三元组：crypto-strategy-spec v0.3-reviewed + wop-sdk-spec v1.0-ratified
           + wop-python-sdk >= 0.1.1（0.1.0 缺尾随位修复链，不可用）
安全纪律：SECURITY.md S1–S8（本文件为 MISSION 周界，变更走人类 MR）
依赖安装：pip install -r requirements.lock（同目录）
退出码：0 成功；1 业务/协议失败；2 配置/环境错误；3 S6 防御性拒绝
当前命令面：keygen / selftest（spec.md 决策 #5 八件套的其余命令随 Phase 3/4 落地）
"""

from __future__ import annotations
import stat
import argparse
import base64
import hashlib
import json
import os
import re
import sys
from pathlib import Path

EXIT_OK, EXIT_FAIL, EXIT_CONFIG, EXIT_DEFENSE = 0, 1, 2, 3

SUITES = ("WOP-RSA3072-SHA256", "WOP-RSA4096-SHA256", "WOP-SM2-SM3")
RSA_SUITE_BITS = {"WOP-RSA3072-SHA256": 3072, "WOP-RSA4096-SHA256": 4096}

# 黄金向量锚（wop-specs ce92dd4，12 条 formatRules）——spec:#9 三元组运行时校验
VECTORS_MD5 = "1033af2c35b498b479e41487ccbda862"
MIN_SDK_VERSION = (0, 1, 1)
FORMAT_RULES_COUNT = 12
HEADER_RULE_IDS = frozenset({
    "header-rsa-ok", "header-sm2-ok", "header-crossfamily",
    "header-double-space", "header-uppercase-hex", "header-wrong-hex-len",
})
B64URL_RULE_IDS = frozenset({
    "b64url-with-padding", "b64url-illegal-char",
    "b64url-trailing-bits-noncanonical-2", "b64url-trailing-bits-noncanonical-3",
    "b64url-trailing-bits-canonical-2", "b64url-trailing-bits-canonical-3",
})
ALL_FORMAT_RULE_IDS = HEADER_RULE_IDS | B64URL_RULE_IDS

# SM2 sm2p256v1 曲线阶 n（公开规范参数，GB/T 32918.5-2017）——keygen d 标量采样范围
_SM2_N = int("FFFFFFFEFFFFFFFFFFFFFFFFFFFFFFFF7203DF6B21C6052B53BBF40939D54123", 16)


# ---------------------------------------------------------------------------
# S6 argv 主动防御（SECURITY.md S6）：私钥内容不得进入命令行
# 检测边界（如实）：PEM 头确定拦；>=256 连续 base64 字符长块拦；
# 短 base64（如 SM2 d 标量 44 字符）无法与合法参数可靠区分——依赖 S1/S3 纪律。
# ---------------------------------------------------------------------------
_PEM_MARKERS = ("-----BEGIN PRIVATE KEY-----", "-----BEGIN RSA PRIVATE KEY-----",
                "-----BEGIN EC PRIVATE KEY-----", "-----BEGIN")
_B64_LONG_RE = re.compile(r"[A-Za-z0-9+/]{256,}|[A-Za-z0-9_-]{256,}")


def guard_argv(argv: list) -> bool:
    """spec:SECURITY-S6 任意参数疑似私钥材料 → 拒绝执行（exit 3）。"""
    for arg in argv:
        if any(marker in arg for marker in _PEM_MARKERS) or _B64_LONG_RE.search(arg):
            sys.stderr.write(
                "wop: 检测到疑似私钥材料出现在命令行参数（SECURITY.md S6/S2 拒绝）。\n"
                "私钥唯一合法通道（S1）：环境变量 WOP_PRIVATE_KEY，或密钥文件路径\n"
                "WOP_PRIVATE_KEY_FILE（权限 0600）。请勿把私钥粘贴到命令行/对话。\n"
            )
            return False
    return True


def _die(code: int, msg: str) -> int:
    sys.stderr.write(f"wop: {msg}\n")
    return code


# ---------------------------------------------------------------------------
# fixture 定位：WOP_VECTORS_PATH env → CLI 同目录 crypto-vectors.json → 仓内 tests/
# ---------------------------------------------------------------------------
def locate_vectors() -> Path:
    env = os.environ.get("WOP_VECTORS_PATH")
    candidates = []
    if env:
        candidates.append(Path(env))
    here = Path(__file__).resolve().parent
    candidates.extend(
        (
            here / "crypto-vectors.json",
            here.parent.parent.parent
            / "tests"
            / "fixtures"
            / "crypto-vectors.json",
        )
    )
    for c in candidates:
        if c.is_file():
            return c
    raise FileNotFoundError(
        "黄金向量 fixture 未找到（查找顺序：$WOP_VECTORS_PATH → CLI 同目录 → 仓内 tests/fixtures/）"
    )


# ---------------------------------------------------------------------------
# keygen —— spec.md 决策 #5；输出纪律 SECURITY.md S4/S5
# ---------------------------------------------------------------------------
def cmd_keygen(args) -> int:
    suite: str = args.suite
    if suite not in SUITES:
        return _die(EXIT_CONFIG, f"未知套件 {suite}；可选：{' / '.join(SUITES)}")
    try:
        from wop_sdk.keys import (
            load_rsa_private_key, load_rsa_public_key,
            load_sm2_private_key, load_sm2_public_key,
        )
        from wop_sdk.sm2crypto import Sm2Ops, sm2_derive_public_hex
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import rsa as _rsa
    except ImportError as exc:
        return _die(EXIT_CONFIG, f"依赖缺失：{exc}（安装：pip install -r requirements.lock）")

    out_dir = Path(args.out_dir).expanduser()
    try:
        out_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        return _die(EXIT_CONFIG, f"输出目录不可用：{exc}")

    if suite in RSA_SUITE_BITS:
        bits = RSA_SUITE_BITS[suite]
        priv = _rsa.generate_private_key(public_exponent=65537, key_size=bits)
        priv_b64 = base64.b64encode(
            priv.private_bytes(serialization.Encoding.DER,
                               serialization.PrivateFormat.PKCS8,
                               serialization.NoEncryption())
        ).decode()
        pub_b64 = base64.b64encode(
            priv.public_key().public_bytes(serialization.Encoding.DER,
                                           serialization.PublicFormat.SubjectPublicKeyInfo)
        ).decode()
        # 回读自检（生成器自证：产物必须能被 SDK 按 D12 契约消费）
        load_rsa_private_key(priv_b64, bits)
        load_rsa_public_key(pub_b64, bits)
    else:
        # SM2：d 标量均匀采样于 [1, n-1]（重采样直至入域）
        d = int.from_bytes(os.urandom(32), "big")
        while not (1 <= d <= _SM2_N - 1):
            d = int.from_bytes(os.urandom(32), "big")
        priv_b64 = base64.b64encode(d.to_bytes(32, "big")).decode()
        xy_hex = sm2_derive_public_hex(f"{d:064x}")
        pub_b64 = base64.b64encode(b"\x04" + bytes.fromhex(xy_hex)).decode()
        # 回读自检 + 签名 roundtrip（点在曲线/可签名由 I5 校验与实签双重保证）
        d2 = load_sm2_private_key(priv_b64)
        if d2 != d.to_bytes(32, "big"):
            return _die(EXIT_FAIL, "SM2 私钥回读不一致（内部错误）")
        pub = load_sm2_public_key(pub_b64)
        ops = Sm2Ops(private_key_hex=f"{d:064x}", public_xy_hex=pub.xy_hex)
        sig = ops.sign(b"wop-keygen-selfcheck", f"{d:064x}")
        if not ops.verify(sig, b"wop-keygen-selfcheck"):
            return _die(EXIT_FAIL, "SM2 签名 roundtrip 自检失败（内部错误）")

    key_path = out_dir / f"merchant_private.{suite}.b64"
    try:
        fd = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(priv_b64 + "\n")
    except FileExistsError:
        return _die(EXIT_CONFIG, f"私钥文件已存在，拒绝覆盖（安全）：{key_path}")
    os.chmod(key_path, 0o600)

    # S4/S5：stdout 只有公钥与路径，零私钥材料
    print(f"suite: {suite}")
    print(f"merchant_public_key(上传平台): {pub_b64}")
    print(f"merchant_private_key_file(0600): {key_path}")
    print("next: 在平台录入公钥；私钥经 WOP_PRIVATE_KEY_FILE 使用（SECURITY.md S1）")
    return EXIT_OK


# ---------------------------------------------------------------------------
# selftest —— spec.md 决策 #5/#9；分层 L1–L5，任一红 → exit 2（拒跑其余命令）
# 向量纪律（docs/research/vectors.md）：testOnly 材料禁入生产路径；
# formatRules 的 header 值仅格式层语义，不作密码学向量。
# ---------------------------------------------------------------------------
class LayerFail(Exception):
    pass


def _check(ok: bool, layer: str, msg: str):
    if not ok:
        raise LayerFail(f"[{layer}] {msg}")


def cmd_selftest(args) -> int:
    results: list = []

    def layer(name: str, fn):
        try:
            detail = fn()
            results.append((name, True, detail or "ok"))
        except LayerFail as exc:
            results.append((name, False, str(exc)))
        except Exception as exc:  # L1 依赖缺失/fixture 缺失等 → 同层红
            results.append((name, False, f"{type(exc).__name__}: {exc}"))

    # L1 依赖导入与版本
    def l1():
        import wop_sdk
        ver = tuple(int(x) for x in wop_sdk.__version__.split("."))
        _check(ver >= MIN_SDK_VERSION, "L1",
               f"wop-python-sdk {wop_sdk.__version__} < 最低要求 {MIN_SDK_VERSION}")
        return f"wop_sdk {wop_sdk.__version__}"

    layer("L1 依赖与版本", l1)

    # fixture 完整性（MD5 锚）——L2 前置但独立成层报告
    vectors_holder: dict = {}

    def lf():
        path = locate_vectors()
        md5 = hashlib.md5(path.read_bytes()).hexdigest()
        _check(md5 == VECTORS_MD5, "FIXTURE",
               f"向量哈希 {md5} != 真源锚 {VECTORS_MD5}（wop-specs ce92dd4）——"
               "fixture 被篡改或版本漂移，selftest 拒跑（spec:#9 / intent A4）")
        vectors_holder["v"] = json.loads(path.read_text(encoding="utf-8"))
        return f"{path.name} md5 ok"

    layer("LF fixture 锚", lf)

    def l2():
        v = vectors_holder.get("v")
        if v is None:
            raise LayerFail("[L2] fixture 未加载（见 LF 层）")
        from wop_sdk.digest import check_digest_header
        from wop_sdk.encoding import b64url_decode
        from wop_sdk.errors import ProtocolFormatError, UnsupportedSuiteError
        from wop_sdk.suites import parse_suite

        rules = v["formatRules"]
        _check(len(rules) == FORMAT_RULES_COUNT, "L2",
               f"formatRules {len(rules)} 条 != 哨兵 {FORMAT_RULES_COUNT}（真源增删即炸）")
        ids = {r["id"] for r in rules}
        _check(ids == ALL_FORMAT_RULE_IDS, "L2",
               f"formatRules id 集合漂移：新增 {ids - ALL_FORMAT_RULE_IDS} / 缺失 {ALL_FORMAT_RULE_IDS - ids}")
        seen_h, seen_b = set(), set()
        for rule in rules:
            rid, expect = rule["id"], rule["expect"]
            if rid in HEADER_RULE_IDS:
                seen_h.add(rid)
                suite = parse_suite(rule.get("suite", "WOP-RSA3072-SHA256"))
                if expect == "accept":
                    check_digest_header(suite, rule["value"])
                else:
                    try:
                        check_digest_header(suite, rule["value"])
                        raise LayerFail(f"[L2] header 规则 {rid} 未按预期拒绝")
                    except (ProtocolFormatError, UnsupportedSuiteError):
                        pass
            elif rid in B64URL_RULE_IDS:
                seen_b.add(rid)
                if expect == "accept":
                    b64url_decode(rule["value"])
                else:
                    try:
                        b64url_decode(rule["value"])
                        raise LayerFail(f"[L2] b64url 规则 {rid} 未按预期拒绝")
                    except ValueError:
                        pass
        _check(seen_h == HEADER_RULE_IDS and seen_b == B64URL_RULE_IDS, "L2", "子集不完备")
        return "formatRules 12/12（header 6 + b64url 6，正负全量）"

    layer("L2 格式规则", l2)

    def l3():
        v = vectors_holder.get("v")
        if v is None:
            raise LayerFail("[L3] fixture 未加载（见 LF 层）")
        from wop_sdk.digest import compute_digest
        from wop_sdk.encoding import b64url_decode, b64url_encode
        from wop_sdk.envelope import unwrap_dek
        from wop_sdk.errors import DecryptError
        from wop_sdk.keys import load_rsa_private_key, load_sm2_private_key, load_sm2_public_key
        from wop_sdk.signature import sign
        from wop_sdk.sm2crypto import Sm2Ops, sm2_sign_with_sm3
        from wop_sdk.suites import parse_suite

        RSA3072 = parse_suite("WOP-RSA3072-SHA256")
        RSA4096 = parse_suite("WOP-RSA4096-SHA256")
        SM2 = parse_suite("WOP-SM2-SM3")
        keys = v["keys"]

        def vec(section, vid):
            return next(x for x in v[section] if x["id"] == vid)

        msg = v["inputs"]["message"].encode("utf-8")
        # digest 正向量（2 条，hex 字节级）
        for vid, suite in (("digest-sha256", RSA3072), ("digest-sm3", SM2)):
            d = vec("digest", vid)
            _check(compute_digest(suite, d["input"].encode("utf-8")).hex() == d["expectedHex"],
                   "L3", f"{vid} 摘要字节不一致")
        # signature 正向量（3 条，签名 b64url 字节级）
        sv = vec("signature", "rsa3072-sign")
        sig = sign(RSA3072, load_rsa_private_key(keys["rsa3072"]["privatePkcs8B64"], 3072), msg)
        _check(b64url_encode(sig) == sv["expectedSigB64u"], "L3", "rsa3072-sign 签名字节不一致")
        sv = vec("signature", "rsa4096-sign")
        sig = sign(RSA4096, load_rsa_private_key(keys["rsa4096"]["privatePkcs8B64"], 4096), msg)
        _check(b64url_encode(sig) == sv["expectedSigB64u"], "L3", "rsa4096-sign 签名字节不一致")
        sv = vec("signature", "sm2-sign-fixedk")
        k_hex = b64url_decode(v["inputs"]["sm2FixedKB64u"]).hex()
        ops = Sm2Ops(private_key_hex=load_sm2_private_key(keys["sm2"]["privateDB64"]).hex(),
                     public_xy_hex=load_sm2_public_key(keys["sm2"]["publicPointB64"]).xy_hex)
        sig = sm2_sign_with_sm3(ops, msg, k_hex)
        _check(b64url_decode(sv["expectedSigB64u"]) == sig and len(sig) == 64,
               "L3", "sm2-sign-fixedk 签名字节不一致（或非裸 r||s 64B）")
        # keyEncrypt 负向量（2 条必须拒，且对外模糊钉死 I7）
        neg = vec("keyEncrypt", "oaep3072-mgf1sha1-trap")
        try:
            unwrap_dek(RSA3072, load_rsa_private_key(keys["rsa3072"]["privatePkcs8B64"], 3072),
                       b64url_decode(neg["cipherB64u"]))
            raise LayerFail("[L3] oaep3072-mgf1sha1-trap 未拒绝（F2 钉子失效）")
        except DecryptError as exc:
            _check(str(exc) == "解密失败", "L3", f"I7 模糊消息被细化：{exc}")
        neg = vec("keyEncrypt", "sm2-encrypt-c1c2c3-mismatch")
        try:
            unwrap_dek(SM2, Sm2Ops(private_key_hex=load_sm2_private_key(keys["sm2"]["privateDB64"]).hex()),
                       b64url_decode(neg["cipherB64u"]))
            raise LayerFail("[L3] sm2-encrypt-c1c2c3-mismatch 未拒绝（顺序钉子失效）")
        except DecryptError:
            pass
        return "digest 2 + signature 3 + 负向量 2（字节级，I7 模糊钉死）"

    layer("L3 密码学字节级", l3)

    def l4():
        v = vectors_holder.get("v")
        if v is None:
            raise LayerFail("[L4] fixture 未加载（见 LF 层）")
        from wop_sdk import WopClient, WopConfig
        keys = v["keys"]
        for suite, kmat in (
            ("WOP-RSA3072-SHA256", keys["rsa3072"]),
            ("WOP-RSA4096-SHA256", keys["rsa4096"]),
            ("WOP-SM2-SM3", keys["sm2"]),
        ):
            priv = kmat["privatePkcs8B64"] if "privatePkcs8B64" in kmat else kmat["privateDB64"]
            pub = kmat["publicSpkiB64"] if "publicSpkiB64" in kmat else kmat["publicPointB64"]
            client = WopClient(WopConfig(app_key="selftest-only", suite=suite,
                                         merchant_private_key=priv, platform_public_key=pub))
            draft = client.build_request("POST", "/gateway/selftest.probe", {"ping": 1})
            h = {k.lower(): v_ for k, v_ in draft.headers.items()}
            digest = h.get("x-wop-content-digest", "")
            _check(re.fullmatch(r"(sha-256|sm3) [0-9a-f]{64}", digest) is not None, "L4",
                   f"{suite} L0 digest 头格式异常：{digest!r}")
            sign_header = h.get("x-wop-sign", "")
            _check(len(sign_header.split("/")) == 4, "L4",
                   f"{suite} x-wop-sign 非四段式：{sign_header[:40]!r}…")
            # spec:2.1 恒必传头全集与入签义务（appkey/nonce/timestamp 恒必传、全入签）
            _check(h.get("x-wop-appkey") == "selftest-only", "L4",  # spec:D14 同源可见段
                   f"{suite} x-wop-appkey 未与 config.appKey 同值：{h.get('x-wop-appkey')!r}")
            _check(re.fullmatch(r"[0-9a-f]{32}", h.get("x-wop-nonce", "")) is not None, "L4",
                   f"{suite} x-wop-nonce 非 CSPRNG 32-hex：{h.get('x-wop-nonce')!r}")
            _check(h.get("x-wop-timestamp", "").isdigit(), "L4",
                   f"{suite} x-wop-timestamp 非毫秒数字串")
            signed = set(sign_header.split("/")[2].split(";"))
            _check({"x-wop-appkey", "x-wop-nonce", "x-wop-timestamp",
                    "x-wop-content-digest"} <= signed, "L4",
                   f"{suite} signedHeaders 缺必传头：{sorted(signed)}")
            _check("x-wop-sign" not in signed, "L4",
                   f"{suite} x-wop-sign 不得参与自身签名")
            _check("x-wop-encrypt" not in h, "L4",  # spec:2.1 否定式：L0 无加密头
                   f"{suite} L0 请求携带了 x-wop-encrypt")
            draft_get = client.build_request("GET", "/gateway/selftest.probe")
            hget = {k.lower(): v_ for k, v_ in draft_get.headers.items()}
            _check("x-wop-content-digest" not in hget, "L4",  # spec:2.1/D2 否定式：GET 禁空摘要
                   f"{suite} GET 无 body 不得携带 digest 头")
            draft2 = client.build_request("POST", "/gateway/selftest.probe",
                                          {"card": "6222000000000000"}, level="L2")
            h2 = {k.lower(): v_ for k, v_ in draft2.headers.items()}
            _check(h2.get("x-wop-encrypt", "").startswith("L2;dek="), "L4",
                   f"{suite} L2 加密头异常")
            signed2 = set(h2["x-wop-sign"].split("/")[2].split(";"))
            _check("x-wop-encrypt" in signed2, "L4",  # spec:2.1：L2 加密头必入签
                   f"{suite} L2 x-wop-encrypt 未入签")
            body = json.loads(draft2.wire_body)
            _check(set(body) == {"encrypted"} and isinstance(body["encrypted"], str), "L4",
                   f"{suite} L2 wire body 非信封 JSON：{str(body)[:40]}")
        return "三套件 L0/L2 构造冒烟（必传头全集+入签义务+digest/sign/encrypt 头 + 信封体）"

    layer("L4 集成冒烟", l4)

    # L5 与 LF 合并语义：MD5 在 LF 已锚；此处输出三元组结论
    def l5():
        import wop_sdk
        return (f"crypto-spec v0.3-reviewed + sdk-spec v1.0-ratified + "
                f"wop-python-sdk {wop_sdk.__version__} ✓ / vectors md5 {VECTORS_MD5[:8]}… ✓")

    layer("L5 三元组", l5)

    all_ok = True
    for name, ok, detail in results:
        print(f"  {'PASS' if ok else 'FAIL'}  {name} — {detail}")
        all_ok = all_ok and ok
    if not all_ok:
        sys.stderr.write("selftest 失败：环境不满足对齐三元组，其余命令拒跑（spec:#9）\n")
        return EXIT_CONFIG
    print("selftest: 全绿")
    return EXIT_OK

# ---------------------------------------------------------------------------
# 运行配置（spec.md 决策 #6 / SECURITY.md S1）——全部经环境变量，零配置文件私钥
# ---------------------------------------------------------------------------
class ConfigError(Exception):
    pass


def _read_key_material(value_env: str, file_env: str) -> str:
    val = os.environ.get(value_env)
    if val and val.strip():
        return val.strip()
    if path := os.environ.get(file_env):
        p = Path(path).expanduser()
        if not p.is_file():
            raise ConfigError(f"密钥文件不存在：{p}")
        mode = stat.S_IMODE(p.stat().st_mode)
        if mode & 0o077:
            raise ConfigError(f"密钥文件权限过宽（{oct(mode)}，须 0600）：{p}")
        return p.read_text(encoding="utf-8").strip()
    raise ConfigError(
        f"缺少密钥：设置 {value_env}（材料值）或 {file_env}（文件路径，权限 0600）——SECURITY.md S1"
    )


def load_client_config(require_gateway: bool = True):
    """装配 WopConfig；任何缺失 → ConfigError（exit 2）。"""
    from wop_sdk import WopConfig
    app_key = os.environ.get("WOP_APP_KEY", "").strip()
    suite = os.environ.get("WOP_SUITE", "").strip()
    if not app_key:
        raise ConfigError("缺少 WOP_APP_KEY")
    if suite not in SUITES:
        raise ConfigError(f"WOP_SUITE 缺失或非法（当前：{suite!r}；可选 {' / '.join(SUITES)}）")
    gateway = os.environ.get("WOP_GATEWAY_URL", "").strip()
    if require_gateway and not gateway:
        raise ConfigError("缺少 WOP_GATEWAY_URL（如 https://wop.example.com）")
    return WopConfig(
        app_key=app_key,
        suite=suite,
        merchant_private_key=_read_key_material("WOP_PRIVATE_KEY", "WOP_PRIVATE_KEY_FILE"),
        platform_public_key=_read_key_material("WOP_PLATFORM_PUBLIC_KEY", "WOP_PLATFORM_PUBLIC_KEY_FILE"),
        gateway_base_url=gateway or None,
    )


def _parse_body(body_arg: str):
    """--body 接受 JSON 文本或 @file 路径。"""
    if body_arg.startswith("@"):
        try:
            raw = Path(body_arg[1:]).read_text(encoding="utf-8")
        except OSError as exc:
            raise ConfigError(f"--body 文件不可读：{exc}") from exc
    else:
        raw = body_arg
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ConfigError(f"--body 不是合法 JSON：{exc}") from exc

def _emit_draft(draft) -> None:
    body_text = draft.wire_body.decode("utf-8", errors="replace") if draft.wire_body else ""
    print(json.dumps({
        "method": draft.method, "path": draft.path, "level": draft.level,
        "headers": draft.headers, "wire_body": body_text,
    }, ensure_ascii=False, indent=2))


def cmd_sign(args) -> int:  # spec:#5-sign 对拍用：仅产 draft 不发送
    try:
        from wop_sdk import WopClient
        from wop_sdk.errors import WopSdkError  # spec:2.2 SDK 出向错误族 → 配置面
        client = WopClient(load_client_config(require_gateway=False))
        body = _parse_body(args.body) if args.body else None
        if args.level == "L2" and body is None:
            return _die(EXIT_FAIL, "L2 封装需要明文 body")
        draft = client.build_request(args.method, args.path, body, level=args.level)
    except ConfigError as exc:
        return _die(EXIT_CONFIG, str(exc))
    except WopSdkError as exc:  # spec:2.2 构造期显式拒（KeyMaterial/跨族等）——禁裸 traceback
        return _die(EXIT_CONFIG, f"请求构造失败（{type(exc).__name__}）：{exc}")
    except (ValueError, TypeError) as exc:  # build_request 直抛面（sdk 侦察 §2.4）
        return _die(EXIT_CONFIG, f"请求构造参数错误：{exc}")
    _emit_draft(draft)
    return EXIT_OK


def cmd_call(args) -> int:  # spec:#5-call 全链路：构造→发送→F6 验证
    try:
        from wop_sdk import WopClient
        from wop_sdk.errors import WopSdkError  # spec:2.2 SDK 出向错误族 → 配置面
        from wop_sdk.transports import UrllibTransport, send_draft
        client = WopClient(load_client_config(require_gateway=True))
        body = _parse_body(args.body) if args.body else None
        if args.level == "L2" and body is None:
            return _die(EXIT_FAIL, "L2 封装需要明文 body")
        draft = client.build_request(args.method, args.path, body, level=args.level)
        resp = send_draft(UrllibTransport(), client._config.gateway_base_url, draft)
    except ConfigError as exc:
        return _die(EXIT_CONFIG, str(exc))
    except WopSdkError as exc:  # spec:2.2 构造期显式拒（KeyMaterial/跨族等）——禁裸 traceback
        return _die(EXIT_CONFIG, f"请求构造失败（{type(exc).__name__}）：{exc}")
    except (ValueError, TypeError) as exc:
        return _die(EXIT_CONFIG, f"请求构造参数错误：{exc}")
    except OSError as exc:
        return _die(EXIT_FAIL, f"网络错误：{exc}")

    resp_body = resp.body or b""
    # 网关错误信封：HTTP 非 2xx 且 code=OP_GW_*
    envelope = None
    try:
        envelope = json.loads(resp_body)
    except (json.JSONDecodeError, UnicodeDecodeError):
        envelope = None
    if envelope and isinstance(envelope, dict) and str(envelope.get("code", "")).startswith("OP_GW_"):
        print(json.dumps({
            "gateway_error": envelope.get("code"),
            "message": envelope.get("message"),
            "http_status": resp.status,
            "trace_id": envelope.get("traceId"),
        }, ensure_ascii=False, indent=2))
        return EXIT_FAIL
    if envelope and isinstance(envelope, dict) and envelope.get("code") not in (None, "SUCCESS"):
        print(json.dumps({  # HTTP 200 下游业务错误（网关透传）
            "downstream_error": envelope.get("code"),
            "message": envelope.get("message"),
        }, ensure_ascii=False, indent=2))
        return EXIT_FAIL
    result = client.verify_response(resp.headers, resp_body, args.path, method=args.method)
    if not result.ok:
        return _die(EXIT_FAIL, f"响应校验失败：{result.reason}")  # I7：reason 模糊
    text = (result.plaintext or b"").decode("utf-8", errors="replace")
    print(text)
    return EXIT_OK


def cmd_verify(args) -> int:  # spec:#5-verify 离线验签（响应/回调）
    try:
        from wop_sdk import WopClient
        client = WopClient(load_client_config(require_gateway=False))
        headers = json.loads(Path(args.headers).read_text(encoding="utf-8"))
        body = Path(args.body).read_bytes()
        if args.callback:
            result = client.verify_callback(headers, body, args.path)
        else:
            result = client.verify_response(headers, body, args.path, method=args.method)
    except ConfigError as exc:
        return _die(EXIT_CONFIG, str(exc))
    except (OSError, json.JSONDecodeError) as exc:
        return _die(EXIT_CONFIG, f"输入文件不可用：{exc}")
    if not result.ok:
        print(json.dumps({"ok": False, "reason": result.reason}, ensure_ascii=False))
        return EXIT_FAIL
    print(json.dumps({
        "ok": True,
        "plaintext": (result.plaintext or b"").decode("utf-8", errors="replace"),
    }, ensure_ascii=False))
    return EXIT_OK


def _mocks_dir() -> Path:
    return Path(__file__).resolve().parent.parent.parent.parent / "mocks" / "api-discovery"


def cmd_api(args) -> int:  # spec:#3/#5-api 动态目录（--mock 读仓内 fixtures）
    if args.api_cmd == "list":
        data = _fetch_discovery("apis", mock=args.mock)
        rows = data.get("apis", [])
        print(f"{'apiFullPath':<40} {'method':<7} {'read':<5} {'ver':<8} status")
        for a in rows:
            print(f"{a['apiFullPath']:<40} {a['httpRequestMethod']:<7} "
                  f"{'yes' if a['queryFlag'] else 'NO':<5} {a['versionNumber']:<8} {a['versionStatus']}")
        print(f"\n{len(rows)} 个 API（授权范围）")
        return EXIT_OK
    # describe
    path = args.path
    if args.mock:
        stem = path.rsplit("/", 1)[-1].replace(".", "-")
        f = _mocks_dir() / f"describe.{stem}.json"
        if not f.is_file():
            return _die(EXIT_FAIL, f"mock 详情不存在：{f.name}（可先用 api list 查看可用 mock）")
        print(json.dumps(json.loads(f.read_text(encoding="utf-8")), ensure_ascii=False, indent=2))
        return EXIT_OK
    data = _fetch_discovery(f"apis{path}", mock=False)
    print(json.dumps(data, ensure_ascii=False, indent=2))
    return EXIT_OK


def _fetch_discovery(suffix: str, mock: bool):
    if mock:
        if suffix == "apis":
            f = _mocks_dir() / "list.json"
            return json.loads(f.read_text(encoding="utf-8"))
    url = os.environ.get("WOP_DISCOVERY_URL", "").strip()
    if not url:
        raise ConfigError(
            "实模式需要 WOP_DISCOVERY_URL（平台 API 发现端点，见 contracts/api-discovery.openapi.yaml）；"
            "本地联调用 --mock"
        )
    import urllib.request
    req = urllib.request.Request(
        f"{url.rstrip('/')}/{suffix}",
        headers={"X-WOP-AppKey": os.environ.get("WOP_APP_KEY", "")},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read().decode("utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ConfigError(f"发现端点不可达/响应异常：{exc}") from exc

def _error_codes() -> dict:
    p = Path(__file__).resolve().parent / "error-codes.json"
    if not p.is_file():
        raise ConfigError(f"错误码目录缺失：{p}（重新生成：python3 scripts/extract_error_codes.py）")
    return json.loads(p.read_text(encoding="utf-8"))


def cmd_diagnose(args) -> int:  # spec:#5-diagnose 三分流 + I7 排查方向（禁猜根因）
    try:
        resp = json.loads(Path(args.response).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return _die(EXIT_CONFIG, f"响应文件不可读：{exc}")
    if not isinstance(resp, dict):
        return _die(EXIT_CONFIG, "响应须为 JSON 对象（信封）")
    try:
        catalog = _error_codes()
    except ConfigError as exc:
        return _die(EXIT_CONFIG, str(exc))
    table = {c["code"]: c for c in catalog["codes"]}

    code = str(resp.get("code", ""))
    http_status = resp.get("http_status") or resp.get("httpStatus")
    trace_id = resp.get("traceId") or resp.get("trace_id")

    def out(d: dict) -> int:
        d["trace_id"] = trace_id
        print(json.dumps(d, ensure_ascii=False, indent=2))
        return EXIT_OK

    if code.startswith("OP_GW_"):
        entry = table.get(code)
        if entry is None:
            return out({"code": code, "known": False,
                        "next": "码表未收录——网关与 CLI 版本漂移？重跑 scripts/extract_error_codes.py"})
        d = {"code": code, "known": True, "meaning": entry["description"],
             "http": entry["http"], "solution": entry["solution"], "segment": entry["segment"]}
        if entry["i7"]:  # I7：只给排查方向，禁猜根因（spec 风险/错误码侦察 §2.4）
            d["i7_vague"] = True
            if code == "OP_GW_1022":
                d["investigate"] = [
                    "对外消息不区分根因（密钥不符/签名串错位/头缺失共用此码）",
                    "用 `wop sign` 对同一输入产出官方 draft，与自研实现逐 header 对拍",
                    "高频根因：base64url 尾随位非规范、SM2 签名误用 DER 编码、C1C2C3 旧国标顺序",
                    "持 traceId 查网关 WARN 日志取真实根因（日志含密钥轮询细节）",
                ]
            else:
                d["investigate"] = [
                    "DEK 解包失败与解密引擎异常共用此码，不区分根因",
                    "核查 x-wop-encrypt 的 dek 载荷 alg 与套件族一致（WOP-RSA*→AES-256-GCM / WOP-SM2→SM4-GCM）",
                    "核查平台公钥是否为最新密钥集（密钥轮换后旧公钥解包必败）",
                    "持 traceId 查网关 WARN 日志取真实根因",
                ]
        return out(d)
    if code:
        return out({"code": code, "known": False, "branch": "downstream",
                    "next": "HTTP 200 下游业务错误（网关透传）——联系该 API 提供方，不查网关码表"})
    return out({"code": None, "branch": "network",
                "next": "无错误信封——检查网络层/代理（连接、TLS、超时），或响应非网关所出"})


def cmd_doctor(args) -> int:  # spec:#5-doctor 环境预检
    issues: list = []
    ok_items: list = []

    v = sys.version_info
    if v >= (3, 9):
        ok_items.append(f"python {v.major}.{v.minor}.{v.micro} ✓")
    else:
        issues.append(f"python {v.major}.{v.minor} < 3.9")
    try:
        import wop_sdk
        ver = tuple(int(x) for x in wop_sdk.__version__.split("."))
        if ver >= MIN_SDK_VERSION:
            ok_items.append(f"wop-python-sdk {wop_sdk.__version__} ✓")
        else:
            issues.append(f"wop-python-sdk {wop_sdk.__version__} < {MIN_SDK_VERSION}（pip install -r requirements.lock）")
    except ImportError as exc:
        issues.append(f"wop-python-sdk 未安装：{exc}")
    for mod, hint in (("cryptography", "pip install cryptography"),
                      ("gmssl", "pip install 'gmssl>=3.2.2'（SM2 套件必需）")):
        try:
            __import__(mod)
            ok_items.append(f"{mod} ✓")
        except ImportError:
            issues.append(f"{mod} 未安装（{hint}）")
    try:
        p = locate_vectors()
        md5 = hashlib.md5(p.read_bytes()).hexdigest()
        if md5 == VECTORS_MD5:
            ok_items.append(f"fixture {p.name} md5 ✓")
        else:
            issues.append(f"fixture 哈希漂移：{md5}（预期 {VECTORS_MD5}）")
    except FileNotFoundError as exc:
        issues.append(str(exc))
    try:
        _error_codes()
        ok_items.append("error-codes.json ✓")
    except (ConfigError, OSError, json.JSONDecodeError) as exc:
        issues.append(f"错误码目录异常：{exc}")

    env_map = {"WOP_APP_KEY": "appKey", "WOP_SUITE": "套件", "WOP_GATEWAY_URL": "网关地址"}
    if missing := [k for k in env_map if not os.environ.get(k, "").strip()]:
        issues.append(f"环境变量未设（call 需要）：{', '.join(missing)}")
    else:
        ok_items.append("环境变量（APP_KEY/SUITE/GATEWAY_URL）✓")
    for val_env, file_env in (("WOP_PRIVATE_KEY", "WOP_PRIVATE_KEY_FILE"), ("WOP_PLATFORM_PUBLIC_KEY", "WOP_PLATFORM_PUBLIC_KEY_FILE")):
        if fp := os.environ.get(file_env):
            from pathlib import Path as _P
            import stat as _st
            p = _P(fp).expanduser()
            if not p.is_file():
                issues.append(f"{file_env} 文件不存在：{p}")
            elif _st.S_IMODE(p.stat().st_mode) & 0o077:
                issues.append(f"{file_env} 权限过宽（须 0600）：{p}")
            else:
                ok_items.append(f"{file_env} 0600 ✓")

    for line in ok_items:
        print(f"  ok   {line}")
    for line in issues:
        print(f"  WARN {line}")
    if issues:
        sys.stderr.write(f"doctor：{len(issues)} 项待修复（配置面，exit 2）\n")
        return EXIT_CONFIG
    print("doctor: 全绿")
    return EXIT_OK


def main(argv: list) -> int:
    if not guard_argv(argv[1:]):  # spec:SECURITY-S6 main 首行防御
        return EXIT_DEFENSE
    parser = argparse.ArgumentParser(prog="wop", description="WOP 网关官方 CLI（wop-cli 基座）")
    sub = parser.add_subparsers(dest="command", required=True)

    p_keygen = sub.add_parser("keygen", help="生成商户密钥对（私钥写 0600 文件，stdout 只出公钥）")
    p_keygen.add_argument("--suite", required=True, choices=SUITES)
    p_keygen.add_argument("--out-dir", default="~/.wop")
    p_keygen.set_defaults(fn=cmd_keygen)

    p_selftest = sub.add_parser("selftest", help="分层自测（向量字节级 + 三元组校验），不过拒跑")
    p_selftest.set_defaults(fn=cmd_selftest)

    p_sign = sub.add_parser("sign", help="构造 draft（headers+wireBody），不发送——对拍用")
    p_sign.add_argument("method", choices=["POST", "GET"])
    p_sign.add_argument("path", help="如 /gateway/logistics.waybill.sync")
    p_sign.add_argument("--body", help="JSON 文本或 @file")
    p_sign.add_argument("--level", default="L0", choices=["L0", "L2"])
    p_sign.set_defaults(fn=cmd_sign)

    p_call = sub.add_parser("call", help="全链路调用：签名→发送→F6 验响应（写操作先经 S7 确认）")
    p_call.add_argument("method", choices=["POST", "GET"])
    p_call.add_argument("path", help="如 /gateway/order.create")
    p_call.add_argument("--body", help="JSON 文本或 @file")
    p_call.add_argument("--level", default="L0", choices=["L0", "L2"])
    p_call.set_defaults(fn=cmd_call)

    p_verify = sub.add_parser("verify", help="离线验签（平台响应 / 回调通知）")
    p_verify.add_argument("--headers", required=True, help="headers JSON 文件")
    p_verify.add_argument("--body", required=True, help="body 原始字节文件")
    p_verify.add_argument("--path", required=True, help="触发请求的 path（回调取回调 path）")
    p_verify.add_argument("--method", default="POST")
    p_verify.add_argument("--callback", action="store_true", help="回调模式（方法恒 POST）")
    p_verify.set_defaults(fn=cmd_verify)

    p_api = sub.add_parser("api", help="API 目录（发现契约）")
    p_api.add_argument("api_cmd", choices=["list", "describe"])
    p_api.add_argument("path", nargs="?", help="describe 用：apiFullPath")
    p_api.add_argument("--mock", action="store_true", help="读仓内 mock fixtures（免端点）")
    p_api.set_defaults(fn=cmd_api)

    p_diag = sub.add_parser("diagnose", help="解析网关错误响应 → 语义 + 排查路径")
    p_diag.add_argument("response", help="错误响应 JSON 文件")
    p_diag.set_defaults(fn=cmd_diagnose)

    p_doctor = sub.add_parser("doctor", help="环境预检：依赖/密钥格式/配置完整性")
    p_doctor.set_defaults(fn=cmd_doctor)

    args = parser.parse_args(argv[1:])
    if args.command == "api" and args.api_cmd == "describe" and not args.path:
        return _die(EXIT_CONFIG, "api describe 需要 apiFullPath 参数")
    try:
        return args.fn(args)
    except ConfigError as exc:
        return _die(EXIT_CONFIG, str(exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
